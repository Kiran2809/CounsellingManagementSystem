<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>

            body {
                margin: 0;
                overflow-x: hidden;
            }

            .sidebar {
                width: 250px;
                min-height: 100vh;
                background: #198754;
                position: fixed;
                left: 0;
                top: 0;
            }

                .sidebar h3 {
                    color: white;
                    text-align: center;
                    padding: 20px;
                }

                .sidebar a {
                    color: white;
                    text-decoration: none;
                    display: block;
                    padding: 15px 20px;
                    transition: .3s;
                }

                    .sidebar a:hover {
                        background: #157347;
                    }

            .content {
                margin-left: 250px;
                padding: 25px;
            }

            .sidebar a.active-menu {
                background: #ffffff;
                color: #198754 !important;
                font-weight: bold;
                border-left: 5px solid yellow;
            }

            .sidebar a:hover {
                background: #157347;
                color: white;
            }

    </style>

</head>

<body>

    <div class="sidebar">

        <h3>🎓 Student</h3>

        <hr class="text-white" />

        <a asp-controller="Student"
           asp-action="Dashboard"
           class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active-menu" : "")">
            <i class="bi bi-speedometer2"></i>
            Dashboard
        </a>

        <a asp-controller="Student"
           asp-action="BookAppointment"
           class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "BookAppointment" ? "active-menu" : "")">
            <i class="bi bi-calendar-plus"></i>
            Book Appointment
        </a>

        <a asp-controller="Student"
           asp-action="ViewAppointments"
           class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "ViewAppointments" ? "active-menu" : "")">
            <i class="bi bi-calendar-check"></i>
            My Appointments
        </a>

        <a asp-controller="Student"
           asp-action="Profile"
           class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active-menu" : "")">
            <i class="bi bi-person"></i>
            My Profile
        </a>

        <a asp-controller="Student"
           asp-action="ChangePassword"
           class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "ChangePassword" ? "active-menu" : "")">
            <i class="bi bi-lock"></i>
            Change Password
        </a>

        <a asp-controller="Student"
           asp-action="Logout">
            <i class="bi bi-box-arrow-right"></i>
            Logout
        </a>

    </div>

    <div class="content">

        @RenderBody()

    </div>

    @RenderSection("Scripts", required: false)

</body>
</html>