@model CounsellingManagementSystem.Models.Counsellor

@{
    Layout = "~/Views/Shared/_CounsellorLayout.cshtml";
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>👨‍🏫 Counsellor Profile</h3>
        </div>

        <div class="card-body">

            <p><strong>Full Name :</strong> @Model.FullName</p>

            <p><strong>Email :</strong> @Model.Email</p>

            <p><strong>Department :</strong> @Model.Department</p>

        </div>

        <div class="card-footer">

            <a asp-action="Dashboard"
               class="btn btn-secondary">
                ← Back to Dashboard
            </a>

        </div>

    </div>

</div>