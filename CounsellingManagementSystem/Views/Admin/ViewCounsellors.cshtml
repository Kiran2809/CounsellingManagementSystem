@model IEnumerable<CounsellingManagementSystem.Models.Counsellor>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Counsellors";
}


<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>👨‍🏫 Counsellors</h2>

        <a asp-action="AddCounsellor" class="btn btn-success">
            <i class="bi bi-person-plus-fill"></i>
            Add Counsellor
        </a>

    </div>

    <form asp-action="ViewCounsellors" method="get">

        <div class="input-group mb-4">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by Name, Email or Department..." />

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>

            @if (!string.IsNullOrEmpty(ViewBag.Search))
            {
                <a asp-action="ViewCounsellors"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            }

        </div>

    </form>
    <div class="mb-3">

        <a asp-action="ExportCounsellorsPdf"
           class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf"></i>
            Export PDF
        </a>

        <a asp-action="ExportCounsellorsExcel"
           class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i>
            Export Excel
        </a>

    </div>

    <table class="table table-bordered table-hover">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.CounsellorId</td>

                    <td>@item.FullName</td>

                    <td>@item.Email</td>

                    <td>@item.Department</td>

                    <td>

                        <a asp-action="DeleteCounsellor"
                           asp-route-id="@item.CounsellorId"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this counsellor?')">

                            🗑 Delete

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>