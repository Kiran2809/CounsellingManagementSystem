@model IEnumerable<CounsellingManagementSystem.Models.Appointment>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Appointments";
}

<div class="container mt-4">

    <form asp-action="ViewAppointments" method="get" class="mb-3">

        <div class="row">

            <div class="col-md-4">

                <select name="status" class="form-select">

                    <option value="">All Appointments</option>

                    <option value="Pending"
                            selected="@(ViewBag.Status == "Pending")">
                        Pending
                    </option>

                    <option value="Approved"
                            selected="@(ViewBag.Status == "Approved")">
                        Approved
                    </option>

                    <option value="Rejected"
                            selected="@(ViewBag.Status == "Rejected")">
                        Rejected
                    </option>

                </select>

            </div>

            <div class="col-md-2">

                <button class="btn btn-primary w-100">
                    Filter
                </button>

            </div>

            <div class="col-md-2">

                <a asp-action="ViewAppointments"
                   class="btn btn-secondary w-100">
                    Reset
                </a>

            </div>

        </div>

    </form>
    <div class="mb-3">

        <a asp-action="ExportToPdf"
           class="btn btn-danger">

            <i class="bi bi-file-earmark-pdf"></i>
            Export PDF

        </a>

        <a asp-action="ExportToExcel"
           class="btn btn-success">

            <i class="bi bi-file-earmark-excel"></i>
            Export Excel

        </a>
    </div>

    <table class="table table-striped table-bordered">

        <thead class="table-dark">
            <tr>
                <th>Student</th>
                <th>Date</th>
                <th>Time</th>
                <th>Reason</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Student.FullName</td>
                    <td>@item.AppointmentDate.ToShortDateString()</td>
                    <td>@item.AppointmentTime</td>
                    <td>@item.Reason</td>
                    <td>@item.Status</td>
                    <td>
                        <a asp-action="DeleteAppointment"
                           asp-route-id="@item.AppointmentId"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this appointment?')">
                            🗑 Delete
                        </a>
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>