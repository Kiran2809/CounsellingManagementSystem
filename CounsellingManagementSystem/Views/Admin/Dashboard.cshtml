@model IEnumerable<CounsellingManagementSystem.Models.Appointment>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">

    <h2 class="mb-4">📊 Admin Dashboard</h2>

    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <h5>Total Students</h5>
                    <h2>@ViewBag.TotalStudents</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <h5>Total Appointments</h5>
                    <h2>@ViewBag.TotalAppointments</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card bg-warning shadow">
                <div class="card-body text-center">
                    <h5>Pending</h5>
                    <h2>@ViewBag.Pending</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card bg-info text-white shadow">
                <div class="card-body text-center">
                    <h5>Approved</h5>
                    <h2>@ViewBag.Approved</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card bg-danger text-white shadow">
                <div class="card-body text-center">
                    <h5>Rejected</h5>
                    <h2>@ViewBag.Rejected</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card bg-secondary text-white shadow">
                <div class="card-body text-center">
                    <h5>Total Counsellors</h5>
                    <h2>@ViewBag.TotalCounsellors</h2>
                </div>
            </div>
        </div>

    </div>

    <hr class="mt-4" />

    <h3 class="mb-3">📅 Recent Appointments</h3>

    <table class="table table-bordered table-hover">

        <thead class="table-dark">
            <tr>
                <th>Student</th>
                <th>Date</th>
                <th>Time</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.Student.FullName</td>

                        <td>@item.AppointmentDate.ToShortDateString()</td>

                        <td>@item.AppointmentTime</td>

                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (item.Status == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No appointments found.
                    </td>
                </tr>
            }

        </tbody>

    </table>

    <a asp-action="ViewStudents" class="btn btn-primary">
        👨‍🎓 View Students
    </a>

    <a asp-action="ViewAppointments" class="btn btn-success">
        📅 View Appointments
    </a>

    <a asp-action="Logout" class="btn btn-danger">
        🚪 Logout
    </a>

    <hr class="mt-5" />

    <h3 class="mb-3">📊 Appointment Status Chart</h3>

    <div class="row justify-content-center">

        <div class="col-md-6">

            <canvas id="statusChart"></canvas>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        const ctx = document.getElementById('statusChart');

        new Chart(ctx, {

            type: 'pie',

            data: {

                labels: ['Approved', 'Pending', 'Rejected'],

                datasets: [{

                    data: [
                                @ViewBag.Approved,
                                @ViewBag.Pending,
                        @ViewBag.Rejected
                    ]

                }]

            }

        });

    </script>
}